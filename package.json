{
  "name": "dencherk-site",
  "version": "1.0.0",
  "private": true,
  "description": "Статический сайт разработчика для GitHub Pages",
  "scripts": {
    "build": "npm run build:css && npm run build:seo",
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "build:seo": "node ./tools/seo.mjs",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --watch",
    "serve": "python -m http.server 8080"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
